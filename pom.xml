<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.maxbot</groupId>
	<artifactId>eventLoop</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>eventLoop</name>
	<description>Свайп-бот подбора мероприятий Пушкинской карты для мессенджера MAX</description>
	<properties>
		<java.version>21</java.version>
		<!-- SDK на линии 0.x: версия пинится жёстко, диапазоны не использовать -->
		<max-bot-api.version>0.5.0</max-bot-api.version>
	</properties>
	<dependencies>
		<!-- В Spring Boot 4 стартер называется webmvc; spring-boot-starter-web устарел.
		     Нужен ради non-daemon потока контейнера и health-эндпоинта для compose. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- В Spring Boot 4 автоконфигурация Flyway вынесена в отдельный стартер:
		     одного flyway-core недостаточно, миграции молча не выполнятся. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<!-- С Flyway 10+ диалекты вынесены из ядра: без этого старт падает
		     на "Unsupported Database: PostgreSQL". -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- MAX Bot API. Артефакт называется ...-spring-boot, а не ...-spring-boot-starter.
		     Его POM не объявляет зависимостей на Spring, поэтому Maven не проверит
		     совместимость версий — несовместимость вылезла бы только в рантайме. -->
		<dependency>
			<groupId>ru.etsft.max</groupId>
			<artifactId>max-bot-api-spring-boot</artifactId>
			<version>${max-bot-api.version}</version>
		</dependency>
		<dependency>
			<groupId>ru.etsft.max</groupId>
			<artifactId>max-bot-api-jackson</artifactId>
			<version>${max-bot-api.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>

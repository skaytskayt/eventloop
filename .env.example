# Скопируйте в .env и подставьте свои значения:  cp .env.example .env
#
# .env добавлен в .gitignore.

# Токен бота: @MasterBot в MAX -> /create (или /list для существующего).
# Обязателен: в коде токена нет, без этой переменной compose не запустится.
# Один токен — один запущенный бот: два long polling одного бота отбирают
# друг у друга сообщения, поэтому для разработки лучше отдельный тестовый бот.
MAX_BOT_TOKEN=

# longpolling — для разработки и демо (вариант по умолчанию).
# webhook — для production: требует публичный HTTPS на 443 и сертификат
# доверенного УЦ, самоподписанные не принимаются. Оба режима одновременно
# использовать нельзя.
MAX_BOT_MODE=longpolling

# Заполняются только при MAX_BOT_MODE=webhook
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=

# Username бота. После ввода баланса бот присылает кнопку, которая открывает
# его мини-приложение (адрес привязан к боту в @MasterBot), и кладёт суммы
# в payload кнопки. Пустой — бот ответит текстом без кнопки.
MAX_BOT_USERNAME=t560_hakaton_max_bot

# Откуда мини-приложению разрешено ходить в /api (CORS), через запятую.
# Нужен только копии на GitHub Pages; по умолчанию — https://skaytskayt.github.io.
# MINIAPP_ORIGINS=https://skaytskayt.github.io

# Администраторы — MAX user id через запятую. Только они видят статистику:
# команда /stats в боте открывает экран статистики в мини-приложении.
# Пусто — статистику не видит никто. Свой id: напишите боту /stats.
ADMIN_MAX_IDS=

# Демо для экспертов: /stats открыт всем с подписью «в проде — только админ».
# В проде поставить false.
STATS_PUBLIC=true

# Локальная база
DB_PASSWORD=eventloop
DB_PORT=5433
APP_PORT=8080

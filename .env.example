# Скопируйте в .env и подставьте свои значения:  cp .env.example .env
#
# .env добавлен в .gitignore.

# Токен бота: @MasterBot в MAX -> /create (или /list для существующего).
# Не обязателен: рабочий токен зашит в application.yml. Эта переменная нужна,
# только чтобы запустить другого бота, не трогая код.
MAX_BOT_TOKEN=

# longpolling — для разработки и демо (вариант по умолчанию).
# webhook — для production: требует публичный HTTPS на 443 и сертификат
# доверенного УЦ, самоподписанные не принимаются. Оба режима одновременно
# использовать нельзя.
MAX_BOT_MODE=longpolling

# Заполняются только при MAX_BOT_MODE=webhook
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=

# Username бота. После ввода баланса бот присылает кнопку, которая открывает
# его мини-приложение (адрес привязан к боту в @MasterBot), и кладёт суммы
# в payload кнопки. Пустой — бот ответит текстом без кнопки.
MAX_BOT_USERNAME=t560_hakaton_max_bot

# Локальная база
DB_PASSWORD=eventloop
DB_PORT=5433
APP_PORT=8080
